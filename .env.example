# ── 基础 ──────────────────────────────────────────────
PORT=8787

# 生产必须改成随机长串：openssl rand -hex 32
JWT_SECRET=change-me

# ── 数据库 / 缓存 ─────────────────────────────────────
POSTGRES_USER=waymuse
POSTGRES_PASSWORD=change-me
POSTGRES_DB=waymuse
DATABASE_URL=postgres://waymuse:change-me@db:5432/waymuse
REDIS_URL=redis://cache:6379

# ── 模型 ──────────────────────────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ── 配额（token）──────────────────────────────────────
MONTHLY_TOKEN_LIMIT=300000
DAILY_TOKEN_LIMIT=30000
# 全局当日成本上限（分），1000 = ¥10
GLOBAL_DAILY_COST_CENTS=1000
# 成本估算：每百万 token 多少分（100 分 = 1 元）
INPUT_CENTS_PER_MILLION=100
OUTPUT_CENTS_PER_MILLION=200

# ── 设备 ──────────────────────────────────────────────
MAX_DEVICES_PER_USER=2

# ── 邮件（QQ 邮箱用授权码，不是登录密码）──────────────
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your-qq@qq.com
SMTP_PASS=授权码
SMTP_FROM=your-qq@qq.com

# ── 人机验证（Cloudflare Turnstile）────────────────────
TURNSTILE_SECRET=
# 本地调试可设 0 关掉
TURNSTILE_REQUIRED=1
