# 站点地址由 .env 里的 SITE_ADDRESS 决定：
#   接域名后：api.waymuse.app
#   还没接域名：101-32-101-117.sslip.io   （自动解析到该 IP，Caddy 会签真证书）
#   纯本地调试：:8787 或 http://localhost

{$SITE_ADDRESS:localhost} {
	# SSE 不能被压缩/缓冲，静态资源才压缩
	@compressible {
		not path /api/ai/*
	}
	encode @compressible zstd gzip

	reverse_proxy api:8787 {
		flush_interval -1
		transport http {
			read_timeout 300s
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}
}
